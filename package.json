{
  "name": "warsztat-wordcamp-wroclaw-2026",
  "version": "1.0.0",
  "description": "WordPress Playground Blueprint z wtyczką Novamira (serwer MCP) oraz klientem mcp-wordpress-remote na warsztat WordCamp Wrocław 2026",
  "main": "blueprint.json",
  "scripts": {
    "start": "wp-playground server --blueprint=blueprint.json --port=9400",
    "playground": "wp-playground server --blueprint=blueprint.json --port=9400",
    "test:blueprint": "wp-playground run-blueprint --blueprint=blueprint.json",
    "mcp": "mcp-wordpress-remote"
  },
  "keywords": [
    "wordpress",
    "wordpress-playground",
    "blueprint",
    "novamira",
    "mcp",
    "model-context-protocol",
    "wordcamp",
    "wordcamp-wroclaw"
  ],
  "author": "Krzysztof Radzikowski",
  "license": "MIT",
  "dependencies": {
    "@automattic/mcp-wordpress-remote": "^0.4.0"
  },
  "devDependencies": {
    "@wp-playground/cli": "^3.1.55"
  }
}
