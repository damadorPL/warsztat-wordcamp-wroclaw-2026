{
  "name": "warsztat-wordcamp-wroclaw-2026",
  "version": "1.0.0",
  "description": "WordPress Playground Blueprint z wtyczką Novamira (serwer MCP) oraz klientem mcp-wordpress-remote na warsztat WordCamp Wrocław 2026",
  "main": "blueprint.json",
  "scripts": {
    "start": "npx -y @wp-playground/cli server --blueprint=blueprint.json --port=9400",
    "playground": "npx -y @wp-playground/cli server --blueprint=blueprint.json --port=9400",
    "test:blueprint": "npx -y @wp-playground/cli run-blueprint --blueprint=blueprint.json",
    "validate:layout": "node dane/validate-layout.js",
    "test:layout": "node dane/validate-layout.js dane/przykladowy-layout.html",
    "mcp": "mcp-wordpress-remote",
    "start:remote": "npx -y @wp-playground/cli server --blueprint=https://raw.githubusercontent.com/damadorPL/warsztat-wordcamp-wroclaw-2026/main/blueprint.json --port=9400"
  },
  "keywords": [
    "wordpress",
    "wordpress-playground",
    "blueprint",
    "novamira",
    "mcp",
    "model-context-protocol",
    "wordcamp",
    "wordcamp-wroclaw"
  ],
  "author": "Krzysztof Radzikowski",
  "license": "MIT",
  "dependencies": {
    "@automattic/mcp-wordpress-remote": "^0.4.0",
    "@wordpress/block-serialization-default-parser": "^5.56.0"
  },
  "devDependencies": {
    "@wp-playground/cli": "latest"
  }
}
